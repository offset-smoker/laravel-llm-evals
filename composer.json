{
    "name": "offset-smoker/laravel-llm-evals",
    "description": "Evaluation harness for LLM features in Laravel: golden datasets, code-based graders, a required falsifiability control, CI exit codes, and a Claude driver built on the official Anthropic PHP SDK.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "llm",
        "evals",
        "evaluation",
        "claude",
        "anthropic",
        "pest",
        "testing"
    ],
    "authors": [
        {
            "name": "Brandon Wagner",
            "email": "b@wagner.codes"
        }
    ],
    "homepage": "https://github.com/offset-smoker/laravel-llm-evals",
    "support": {
        "issues": "https://github.com/offset-smoker/laravel-llm-evals/issues",
        "source": "https://github.com/offset-smoker/laravel-llm-evals",
        "security": "https://github.com/offset-smoker/laravel-llm-evals/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "anthropic-ai/sdk": "^1.3",
        "illuminate/console": "^12.69|^13.30",
        "illuminate/contracts": "^12.69|^13.30",
        "illuminate/support": "^12.69|^13.30",
        "opis/json-schema": "^2.6",
        "php-http/discovery": "^1.20",
        "psr/http-factory": "^1.1",
        "symfony/yaml": "^7.2|^8.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.3",
        "larastan/larastan": "^3.13.2",
        "laravel/pint": "^1.32",
        "open-telemetry/api": "^1.1",
        "open-telemetry/context": "^1.1",
        "orchestra/testbench": "^10.0|^11.0",
        "paragonie/random_compat": "^9.99",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-strict-rules": "^2.1"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client for the Anthropic SDK. Laravel applications already have it."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "OffsetSmoker\\LlmEvals\\": "src/"
        },
        "files": [
            "src/Pest/expectations.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OffsetSmoker\\LlmEvals\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "OffsetSmoker\\LlmEvals\\LlmEvalsServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "test": "pest"
    }
}
